#!/bin/bash
# =============================================================================
#  GATK4 Joint Variant Calling Pipeline — PGx Genes
#  ACE HPC | SLURM | conda annotation env
#
#  WORKFLOW (3 steps, submit in order):
#    Step 1 — HaplotypeCaller per-sample → .g.vcf.gz  (array job)
#    Step 2 — GenomicsDBImport → combine all samples
#    Step 3 — GenotypeGVCFs → joint-called VCF per population
#
#  USAGE:
#    # Step 1 first (array job — one job per sample)
#    sbatch --array=0-$(( $(wc -l < samples_AFR.txt) - 1 )) gatk_joint_calling.sh AFR step1
#
#    # After ALL step1 jobs finish:
#    sbatch gatk_joint_calling.sh AFR step2
#
#    # After step2 finishes:
#    sbatch gatk_joint_calling.sh AFR step3
#
#    # Repeat for EAS, EUR, SAS
# =============================================================================

# ── SLURM DIRECTIVES ──────────────────────────────────────────────────────────
#SBATCH --job-name=gatk_pgx
#SBATCH --array=0-$(( $(wc -l < samples_AFR.txt) - 1 )) gatk_joint_calling.sh AFR step1
sbatch --array=0-$(( $(wc -l < results/gatk/AFR/samples_AFR.txt) - 1 )) gatk_joint_calling.sh AFR step1
#SBATCH --output=/etc/ace-data/home/rnagaba/reset/logs/gatk_%j_%x.out
#SBATCH --error=/etc/ace-data/home/rnagaba/reset/logs/gatk_%j_%x.err
#SBATCH --cpus-per-task=10
#SBATCH --mem=64G

set -euo pipefail

# ── ARGUMENTS ────────────────────────────────────────────────────────────────
POP="${1:-AFR}"        # AFR | EAS | EUR | SAS
STEP="${2:-step1}"     # step1 | step2 | step3

# ── PATHS ────────────────────────────────────────────────────────────────────
BASE="/etc/ace-data/home/rnagaba/reset"
DATA_DIR="${BASE}/data/${POP}"
OUT_DIR="${BASE}/results/gatk/${POP}"
GVCF_DIR="${OUT_DIR}/gvcfs"
DB_DIR="${OUT_DIR}/genomicsdb"
LOG_DIR="${BASE}/logs"

mkdir -p "${GVCF_DIR}" "${OUT_DIR}" "${LOG_DIR}"

# ── REFERENCE ────────────────────────────────────────────────────────────────
# hg38 — same reference used for alignment
REF="${BASE}/reference/hg38"
# If your reference is elsewhere, update this path. Must have .fai and .dict


# GATK — try module first, fall back to conda install
if command -v gatk &>/dev/null; then
    GATK="gatk"
elif module load GATK 2>/dev/null && command -v gatk &>/dev/null; then
    GATK="gatk"
else
    # Install GATK into conda env if not present
    echo "[INFO] GATK not found — installing via conda..."
    conda install -y -c bioconda gatk4 2>/dev/null || \
    pip install gatk4 2>/dev/null || \
    { echo "[ERROR] Could not install GATK. See installation note below."; exit 1; }
    GATK="gatk"
fi

echo "[INFO] GATK version: $(${GATK} --version 2>&1 | head -1)"
echo "[INFO] Population: ${POP} | Step: ${STEP}"

# ── PGx TARGET INTERVALS ─────────────────────────────────────────────────────
# hg38 coordinates for the 9 pharmacogenes
# Format: chrom:start-end  (1-based, inclusive)
INTERVALS=(
    "chr10:94762681-94855547"   # CYP2C19
    "chr10:96698415-96748853"   # CYP2C9
    "chr22:42126499-42130865"   # CYP2D6
    "chr19:15878663-15916641"   # CYP4F2
    "chr16:31096174-31111938"   # VKORC1
    "chr2:85545546-85612953"    # GGCX
    "chr4:69048012-69118744"    # UGT2B7
    "chr6:154039662-154137408"  # OPRM1
    "chr11:113409605-113475553" # DRD2
    "chr7:128189484-128236610"  # CALU
)

# Build interval string for GATK (space-separated -L flags)
INTERVAL_ARGS=""
for iv in "${INTERVALS[@]}"; do
    INTERVAL_ARGS="${INTERVAL_ARGS} -L ${iv}"
done

# ── SAMPLE LIST ───────────────────────────────────────────────────────────────
# Build sample list from BAM files found under DATA_DIR
# Expected structure: DATA_DIR/<SUBPOP>/<SAMPLE>/aligned/<SAMPLE>.bam
SAMPLE_LIST="${OUT_DIR}/samples_${POP}.txt"

if [[ ! -f "${SAMPLE_LIST}" ]]; then
    echo "[INFO] Building sample list..."
    find "${DATA_DIR}" -name "*.bam" -not -name "*.bai" | sort > "${SAMPLE_LIST}"
    echo "[INFO] Found $(wc -l < ${SAMPLE_LIST}) BAM files"
fi

# ─────────────────────────────────────────────────────────────────────────────
#  STEP 1 — HaplotypeCaller per-sample (SLURM array job)
#  Produces a GVCF for each sample, restricted to PGx intervals only
#  Each job processes one BAM file (identified by SLURM_ARRAY_TASK_ID)
# ─────────────────────────────────────────────────────────────────────────────
if [[ "${STEP}" == "step1" ]]; then

    # Get this sample's BAM from the list using array task ID
    BAM=$(sed -n "$((SLURM_ARRAY_TASK_ID + 1))p" "${SAMPLE_LIST}")

    if [[ -z "${BAM}" ]]; then
        echo "[ERROR] No BAM found for array task ${SLURM_ARRAY_TASK_ID}"
        exit 1
    fi

    SAMPLE=$(basename "${BAM}" .bam)
    GVCF="${GVCF_DIR}/${SAMPLE}.g.vcf.gz"

    echo "[INFO] Processing sample: ${SAMPLE}"
    echo "[INFO] BAM: ${BAM}"
    echo "[INFO] Output GVCF: ${GVCF}"

    # Skip if GVCF already exists and is not empty
    if [[ -f "${GVCF}" && -f "${GVCF}.tbi" ]]; then
        echo "[INFO] GVCF already exists — skipping ${SAMPLE}"
        exit 0
    fi

    # Check BAM index exists; create if missing
    if [[ ! -f "${BAM}.bai" && ! -f "${BAM%.bam}.bai" ]]; then
        echo "[INFO] Indexing BAM: ${SAMPLE}"
        ${GATK} BuildBamIndex -I "${BAM}"
    fi

    # Run HaplotypeCaller in GVCF mode
    # -ERC GVCF = emit reference confidence blocks (required for joint calling)
    # --sample-name overrides read group SM if it differs from file name
    ${GATK} HaplotypeCaller \
        --java-options "-Xmx28g -XX:ParallelGCThreads=4" \
        -R "${REF}" \
        -I "${BAM}" \
        -O "${GVCF}" \
        -ERC GVCF \
        ${INTERVAL_ARGS} \
        --tmp-dir "${OUT_DIR}/tmp" \
        --native-pair-hmm-threads "${SLURM_CPUS_PER_TASK}" \
        --verbosity ERROR \
        2>&1 | tee "${LOG_DIR}/${SAMPLE}_haplotypecaller.log"

    echo "[INFO] Done: ${SAMPLE} → ${GVCF}"
    exit 0
fi

# ─────────────────────────────────────────────────────────────────────────────
#  STEP 2 — GenomicsDBImport
#  Combines all per-sample GVCFs into a GenomicsDB workspace
#  One DB per interval (gene), merged at the end by GenotypeGVCFs
#  Run AFTER all step1 array jobs have completed
# ─────────────────────────────────────────────────────────────────────────────
if [[ "${STEP}" == "step2" ]]; then

    echo "[INFO] Building GVCF sample map..."

    # Build sample map: sample_name<TAB>path/to/sample.g.vcf.gz
    SAMPLE_MAP="${OUT_DIR}/sample_map_${POP}.tsv"
    > "${SAMPLE_MAP}"

    while IFS= read -r BAM; do
        SAMPLE=$(basename "${BAM}" .bam)
        GVCF="${GVCF_DIR}/${SAMPLE}.g.vcf.gz"
        if [[ -f "${GVCF}" ]]; then
            echo -e "${SAMPLE}\t${GVCF}" >> "${SAMPLE_MAP}"
        else
            echo "[WARN] Missing GVCF for ${SAMPLE} — skipping"
        fi
    done < "${SAMPLE_LIST}"

    N_SAMPLES=$(wc -l < "${SAMPLE_MAP}")
    echo "[INFO] ${N_SAMPLES} samples in map"

    if [[ "${N_SAMPLES}" -eq 0 ]]; then
        echo "[ERROR] No GVCFs found. Did step1 complete?"
        exit 1
    fi

    # Build one interval string per chromosome region
    # GenomicsDBImport needs -L for each interval
    INTERVAL_FILE="${OUT_DIR}/pgx_intervals.list"
    printf '%s\n' "${INTERVALS[@]}" > "${INTERVAL_FILE}"

    DB_PATH="${DB_DIR}/pgx_${POP}"

    # Remove existing DB if rerunning (GenomicsDBImport cannot overwrite)
    if [[ -d "${DB_PATH}" ]]; then
        echo "[WARN] Removing existing DB at ${DB_PATH}"
        rm -rf "${DB_PATH}"
    fi

    echo "[INFO] Running GenomicsDBImport..."
    echo "[INFO] DB path: ${DB_PATH}"

    ${GATK} GenomicsDBImport \
        --java-options "-Xmx28g -XX:ParallelGCThreads=4" \
        --sample-name-map "${SAMPLE_MAP}" \
        --genomicsdb-workspace-path "${DB_PATH}" \
        -L "${INTERVAL_FILE}" \
        --reader-threads "${SLURM_CPUS_PER_TASK}" \
        --batch-size 50 \
        --tmp-dir "${OUT_DIR}/tmp" \
        --verbosity ERROR \
        2>&1 | tee "${LOG_DIR}/genomicsdb_${POP}.log"

    echo "[INFO] GenomicsDB built: ${DB_PATH}"
    exit 0
fi

# ─────────────────────────────────────────────────────────────────────────────
#  STEP 3 — GenotypeGVCFs
#  Jointly genotypes all samples from the GenomicsDB
#  Produces the final multi-sample VCF with FILTER and FORMAT fields
#  Run AFTER step2 has completed
# ─────────────────────────────────────────────────────────────────────────────
if [[ "${STEP}" == "step3" ]]; then

    DB_PATH="${DB_DIR}/pgx_${POP}"
    RAW_VCF="${OUT_DIR}/${POP}_pgx_raw.vcf.gz"
    FILTERED_VCF="${OUT_DIR}/${POP}_pgx_filtered.vcf.gz"

    if [[ ! -d "${DB_PATH}" ]]; then
        echo "[ERROR] GenomicsDB not found at ${DB_PATH}. Did step2 complete?"
        exit 1
    fi

    echo "[INFO] Running GenotypeGVCFs..."
    echo "[INFO] Input DB: ${DB_PATH}"
    echo "[INFO] Output VCF: ${RAW_VCF}"

    ${GATK} GenotypeGVCFs \
        --java-options "-Xmx28g -XX:ParallelGCThreads=4" \
        -R "${REF}" \
        -V "gendb://${DB_PATH}" \
        -O "${RAW_VCF}" \
        ${INTERVAL_ARGS} \
        --tmp-dir "${OUT_DIR}/tmp" \
        --verbosity ERROR \
        2>&1 | tee "${LOG_DIR}/genotypegvcfs_${POP}.log"

    echo "[INFO] Raw VCF written: ${RAW_VCF}"

    # ── VARIANT FILTRATION ────────────────────────────────────────────────
    # Hard filters — VQSR requires >30 samples for SNPs and >10 for indels.
    # Use hard filters if cohort is small; use VQSR if large (>100 samples).
    # SNP filter thresholds from GATK best practices:
    #   QD < 2.0    — quality by depth (low = unreliable genotype)
    #   MQ < 40.0   — mapping quality (low = reads mapping badly)
    #   FS > 60.0   — Fisher strand bias
    #   SOR > 3.0   — strand odds ratio
    #   MQRankSum < -12.5 — mapping quality rank sum
    #   ReadPosRankSum < -8.0 — read position rank sum

    echo "[INFO] Applying hard filters..."

    # Separate SNPs and indels, filter separately, then merge
    SNP_RAW="${OUT_DIR}/${POP}_snps_raw.vcf.gz"
    INDEL_RAW="${OUT_DIR}/${POP}_indels_raw.vcf.gz"
    SNP_FILT="${OUT_DIR}/${POP}_snps_filtered.vcf.gz"
    INDEL_FILT="${OUT_DIR}/${POP}_indels_filtered.vcf.gz"

    # Select SNPs
    ${GATK} SelectVariants \
        --java-options "-Xmx16g" \
        -R "${REF}" \
        -V "${RAW_VCF}" \
        --select-type-to-include SNP \
        -O "${SNP_RAW}"

    # Filter SNPs
    ${GATK} VariantFiltration \
        --java-options "-Xmx16g" \
        -R "${REF}" \
        -V "${SNP_RAW}" \
        --filter-expression "QD < 2.0"            --filter-name "QD2" \
        --filter-expression "MQ < 40.0"           --filter-name "MQ40" \
        --filter-expression "FS > 60.0"           --filter-name "FS60" \
        --filter-expression "SOR > 3.0"           --filter-name "SOR3" \
        --filter-expression "MQRankSum < -12.5"   --filter-name "MQRankSum-12.5" \
        --filter-expression "ReadPosRankSum < -8.0" --filter-name "ReadPosRankSum-8" \
        -O "${SNP_FILT}"

    # Select Indels
    ${GATK} SelectVariants \
        --java-options "-Xmx16g" \
        -R "${REF}" \
        -V "${RAW_VCF}" \
        --select-type-to-include INDEL \
        -O "${INDEL_RAW}"

    # Filter Indels
    ${GATK} VariantFiltration \
        --java-options "-Xmx16g" \
        -R "${REF}" \
        -V "${INDEL_RAW}" \
        --filter-expression "QD < 2.0"            --filter-name "QD2" \
        --filter-expression "FS > 200.0"          --filter-name "FS200" \
        --filter-expression "SOR > 10.0"          --filter-name "SOR10" \
        --filter-expression "ReadPosRankSum < -20.0" --filter-name "ReadPosRankSum-20" \
        -O "${INDEL_FILT}"

    # Merge SNPs + Indels back
    ${GATK} MergeVcfs \
        --java-options "-Xmx16g" \
        -I "${SNP_FILT}" \
        -I "${INDEL_FILT}" \
        -O "${FILTERED_VCF}"

    # Clean up intermediate files
    rm -f "${SNP_RAW}" "${SNP_RAW}.tbi" \
          "${INDEL_RAW}" "${INDEL_RAW}.tbi" \
          "${SNP_FILT}" "${SNP_FILT}.tbi" \
          "${INDEL_FILT}" "${INDEL_FILT}.tbi"

    echo "[INFO] Filtered VCF: ${FILTERED_VCF}"

    # Summary stats
    echo ""
    echo "=== SUMMARY: ${POP} joint-called VCF ==="
    bcftools stats "${FILTERED_VCF}" | grep "^SN" | grep -E "records|SNPs|indels|MNPs"
    echo ""
    echo "PASS variants only:"
    bcftools view -f PASS "${FILTERED_VCF}" | bcftools stats | grep "^SN" | grep -E "records|SNPs|indels"

    exit 0
fi

echo "[ERROR] Unknown step: ${STEP}. Use step1, step2, or step3."
exit 1
